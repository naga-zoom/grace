# One execution prompt. Source identity checks and routing are deterministic.
\configuration ->
\(task :
  { taskCohort: Text, workflowCohort: Text, contextProtocol: Text, qualityProtocol: Text, trialEpoch: Optional Text
  , goal: Text, acceptanceCriteria: List Text, negativeEvidence: List Text
  , sourcePackets: List { id: Text, content: Text }, requiredSourceIds: List Text
  }) ->
let policy = ./policy.ffg
let select : forall (a : Type) . (a -> Bool) -> List a -> List a
      = \predicate -> fold { cons: \x -> \xs -> if predicate x then [ x ] + xs else xs, nil: [ ] }
let all : forall (a : Type) . (a -> Bool) -> List a -> Bool
      = \predicate -> fold { cons: \x -> \rest -> predicate x && rest, nil: true }
let count : forall (a : Type) . List a -> Natural = fold { cons: \_ -> \rest -> rest + 1, nil: 0 }
let uniqueIds = \(ids : List Text) -> all (\(id : Text) -> id != "" && count (select (\(other : Text) -> other == id) ids) == 1) ids
let packetIds = map (\(packet : { id: Text, content: Text }) -> packet.id) task.sourcePackets
let knownRequired = uniqueIds task.requiredSourceIds && all (\(id : Text) -> count (select (\(other : Text) -> other == id) packetIds) == 1) task.requiredSourceIds
let decision =
      if uniqueIds packetIds && knownRequired
      then policy configuration
            { role: "execution", taskCohort: task.taskCohort, workflowCohort: task.workflowCohort
            , contextProtocol: task.contextProtocol, qualityProtocol: task.qualityProtocol, trialEpoch: task.trialEpoch }
      else Refused { reason: "Unknown, empty or ambiguous source reference" }
# Required IDs are a minimum dependency floor, never permission to omit other facts.
# Typed reply shape is not semantic acceptance; caller tests and independent review remain necessary.
in fold
      { Routed: \chosen ->
          let response = prompt
                { model: chosen.model, effort: chosen.effort
                , text: show
                    { role: "execution", goal: task.goal, acceptanceCriteria: task.acceptanceCriteria
                    , negativeEvidence: task.negativeEvidence, sources: task.sourcePackets
                    , requiredSourceIds: task.requiredSourceIds }
                } : { reply: Text }
          in { status: "candidate"
             , stages: [ { role: "execution", size: chosen.size, model: chosen.model, modelVersion: chosen.modelVersion
                         , effort: chosen.effort, source: chosen.source, reply: response.reply } ]
             , proposal: null : Optional { proposedProfile: Text, rationale: Text }
             , refusal: null : Optional Text, adoptionAllowed: false }
      , Refused: \error ->
          { status: "refused", stages: [ ], proposal: null : Optional { proposedProfile: Text, rationale: Text }
          , refusal: some error.reason, adoptionAllowed: false }
      }
      decision
